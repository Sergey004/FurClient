{
  "name": "fa-nexus",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "windows": "react-native run-windows",
    "macos": "react-native run-macos",
    "start": "react-native start",
    "web:dev": "vite",
    "web:build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:copy-bundle": "shx cp web-build/bundle.js electron/bundle.js",
    "verify-bundle": "node scripts/verify-bundle.js",
    "electron:build:linux": "vite build && npm run electron:copy-bundle && npm run verify-bundle && electron-builder --linux",
    "electron:build:win": "vite build && npm run electron:copy-bundle && npm run verify-bundle && electron-builder --win",
    "electron:build:mac": "vite build && npm run electron:copy-bundle && npm run verify-bundle && electron-builder --mac",
    "electron:build:all": "vite build && npm run electron:copy-bundle && npm run verify-bundle && electron-builder --linux --win --mac",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.furclient.app",
    "productName": "FurClient",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@vitejs/plugin-react": "^4.4.1",
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.2.1",
    "chrome-remote-interface": "^0.34.0",
    "htmlparser2": "^10.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-native": "^0.79.2",
    "react-native-fast-image": "^8.6.3",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.10.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "^13.12.5",
    "vite": "^6.3.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-native": "^0.73.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.1.0",
    "electron-builder": "^26.0.12",
    "react-native-macos": "^0.79.0",
    "react-native-windows": "^0.79.0",
    "shx": "^0.4.0",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.3"
  }
}
